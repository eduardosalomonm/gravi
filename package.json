{
  "name": "gravi-mascota-gravedad",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "node --test tests/*.test.mjs",
    "test:playthrough": "node tests/browser/planet-playthrough.mjs",
    "test:mobile": "node tests/browser/mobile-controls.mjs",
    "test:regressions": "node tests/browser/audit-regressions.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "three": "^0.185.1",
    "vinext": "1.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/workers-types": "5.20261023.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "fast-glob": "file:tools/fast-glob-compat",
    "oxfmt": "0.73.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.64.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.4",
    "wrangler": "4.154.0"
  },
  "type": "module",
  "overrides": {
    "vite-plugin-dynamic-import": {
      "fast-glob": "$fast-glob"
    },
    "satori": {
      "fflate": "0.7.5"
    }
  }
}
